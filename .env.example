# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Atlas / Local Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/hari_engineering_db

# Administrator Security Key / Login Passkey
ADMIN_KEY=admin123

# JWT Secret Key for Admin Authentication
JWT_SECRET=hari_engineering_secret_jwt_key_2026_secure

# Optional Email Dispatch Configuration (SMTP)
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Hari Engineering Works <sales@hariengineeringworks.com>
