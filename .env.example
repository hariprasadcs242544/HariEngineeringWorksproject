# Server Configuration
PORT=5000

# Database Connection (MongoDB Atlas or Local MongoDB)
# Replace with your Atlas connection string, e.g.:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hari_engineering_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hari_engineering_db

# Admin Security Key for protected CRUD operations
ADMIN_KEY=admin123
